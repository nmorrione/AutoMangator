<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Web2Comic"
             x:Class="Web2Comic.SeriesInfoPanel">
  <!-- Dati della serie per gli EPUB: usato nella finestra principale e in "Converti CBZ in EPUB".
       Un campo per riga (solo Anno e Lingua, corti, stanno affiancati): entra anche in una colonna stretta. -->
  <StackPanel Spacing="6">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
      <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{local:Tr Series.Series}" FontWeight="SemiBold" />
      <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtSeries" />

      <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{local:Tr Series.Writer}" />
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtWriter" />

      <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{local:Tr Series.Artist}" />
      <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtArtist" PlaceholderText="{local:Tr Series.ArtistHint}" />

      <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{local:Tr Series.Publisher}" />
      <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtPublisher" />

      <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="{local:Tr Series.Year}" />
      <Grid      Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
        <TextBox x:Name="txtYear" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{local:Tr Series.Language}" />
        <TextBox Grid.Column="2" x:Name="txtLanguage" PlaceholderText="it, en, es, ja..." ToolTip.Tip="{local:Tr Series.LanguageTip}" />
      </Grid>

      <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="{local:Tr Series.Genre}" />
      <TextBox   Grid.Row="5" Grid.Column="1" x:Name="txtGenre" PlaceholderText="{local:Tr Series.GenreHint}" />

      <TextBlock Grid.Row="6" VerticalAlignment="Top" Margin="0,6,0,0" Text="{local:Tr Series.Summary}" />
      <TextBox   Grid.Row="6" Grid.Column="1" x:Name="txtSummary" Height="70" AcceptsReturn="True" TextWrapping="Wrap" />
    </Grid>
    <WrapPanel Orientation="Horizontal" ItemSpacing="24">
      <CheckBox x:Name="chkRtl" Content="{local:Tr Series.Rtl}" />
      <CheckBox x:Name="chkKobo" Content="{local:Tr Series.Kobo}" ToolTip.Tip="{local:Tr Series.KoboTip}" />
    </WrapPanel>
  </StackPanel>
</UserControl>
