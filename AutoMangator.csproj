<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoMangator</RootNamespace>
    <AssemblyName>AutoMangator</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- icon.svg è la sorgente; icon.ico (exe Windows), AppIcon.icns (app macOS) e icon.png
         (finestra) si rigenerano con Assets\make-icons.cs, uno script a sé che non fa parte dell'app -->
    <AvaloniaResource Include="Assets\icon.png" />
    <Compile Remove="Assets\make-icons.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>

</Project>
